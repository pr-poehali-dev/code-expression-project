{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "GET daily_post without key — 403",
      "method": "GET",
      "path": "/?action=daily_post",
      "expectedStatus": 403
    },
    {
      "name": "GET list — 200",
      "method": "GET",
      "path": "/?action=list",
      "expectedStatus": 200
    },
    {
      "name": "GET unknown action — 404",
      "method": "GET",
      "path": "/",
      "expectedStatus": 404
    }
  ]
}
