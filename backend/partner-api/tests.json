{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Unknown action",
      "method": "GET",
      "path": "/?action=nope",
      "expectedStatus": 404
    },
    {
      "name": "Me without session",
      "method": "GET",
      "path": "/?action=me",
      "expectedStatus": 401
    },
    {
      "name": "Login without data",
      "method": "POST",
      "path": "/?action=login",
      "body": {},
      "expectedStatus": 400
    },
    {
      "name": "Admin without session",
      "method": "GET",
      "path": "/?action=admin_overview",
      "expectedStatus": 403
    },
    {
      "name": "Register without consents",
      "method": "POST",
      "path": "/?action=register",
      "body": {
        "business_name": "Тест",
        "contact_name": "Тест",
        "email": "consent-test@example.com",
        "password": "password123",
        "consent_rules": true,
        "consent_privacy": false,
        "consent_offer": true
      },
      "expectedStatus": 400
    },
    {
      "name": "Admin view session without admin",
      "method": "POST",
      "path": "/?action=admin_view_session",
      "body": {
        "partner_id": 1
      },
      "expectedStatus": 403
    },
    {
      "name": "Password forgot without email",
      "method": "POST",
      "path": "/?action=password_forgot",
      "body": {},
      "expectedStatus": 400
    },
    {
      "name": "Password reset bad token",
      "method": "POST",
      "path": "/?action=password_reset",
      "body": {
        "token": "x",
        "password": "longpassword1"
      },
      "expectedStatus": 400
    },
    {
      "name": "Password change without session",
      "method": "POST",
      "path": "/?action=password_change",
      "body": {
        "old_password": "a",
        "new_password": "longpassword1"
      },
      "expectedStatus": 401
    },
    {
      "name": "Ref visit unknown code",
      "method": "POST",
      "path": "/?action=ref_visit",
      "body": {
        "ref": "PT-XXXXXX",
        "visitor_id": "abcdefgh12345678"
      },
      "expectedStatus": 200
    },
    {
      "name": "Inquiry without data",
      "method": "POST",
      "path": "/?action=inquiry",
      "body": {},
      "expectedStatus": 400
    }
  ]
}