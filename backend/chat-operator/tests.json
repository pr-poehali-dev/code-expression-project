{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Empty messages returns 400",
      "method": "POST",
      "path": "/",
      "body": {"messages": []},
      "expectedStatus": 400
    },
    {
      "name": "GET set_webhook without key — 403",
      "method": "GET",
      "path": "/?action=set_webhook&url=https://example.com",
      "expectedStatus": 403
    },
    {
      "name": "GET webhook_info without key — 403",
      "method": "GET",
      "path": "/?action=webhook_info",
      "expectedStatus": 403
    },
    {
      "name": "POST empty telegram update — 200 ok",
      "method": "POST",
      "path": "/",
      "body": {"update_id": 1},
      "expectedStatus": 200,
      "expectedBody": {"ok": true},
      "bodyMatcher": "partial"
    }
  ]
}
